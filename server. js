let mongoClient = null;
let credsCollection = null;

async function connectMongo() {
    if (!process.env.MONGODB_URI) {
        console.warn('⚠️ MONGODB_URI non défini, les sessions ne seront pas persistantes.');
        return;
    }
    try {
        mongoClient = new MongoClient(process.env.MONGODB_URI);
        await mongoClient.connect();
        const db = mongoClient.db('whatsapp_bot');
        credsCollection = db.collection('creds');
        console.log('✅ MongoDB connecté.');
    } catch (e) {
        console.error('❌ Erreur MongoDB:', e);
    }
}

async function getCreds() {
    if (!credsCollection) return null;
    const doc = await credsCollection.findOne({ _id: 'creds' });
    return doc ? doc.data : null;
}

async function saveCreds(data) {
    if (!credsCollection) return;
    await credsCollection.updateOne(
        { _id: 'creds' },
        { $set: { data: data } },
        { upsert: true }
    );
}

// ============================================================
//  FONCTIONS UTILITAIRES
