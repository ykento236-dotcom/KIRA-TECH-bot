const SETTINGS_FILE = './groupSettings.json';

async function loadSettings() {
    try {
        if (fs.existsSync(SETTINGS_FILE)) {
            groupSettings = await fs.readJson(SETTINGS_FILE);
        }
    } catch (e) {
        groupSettings = {};
    }
}

async function saveSettings() {
    await fs.writeJson(SETTINGS_FILE, groupSettings, { spaces: 2 });
}

